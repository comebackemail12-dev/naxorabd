        "codMaxOrderBdt": { "type": "number" },
        "codAdvanceDeliveryOutsideDhaka": { "type": "boolean" },
        "deliveryInsideDhakaBdt": { "type": "number" },
        "deliveryOutsideDhakaBdt": { "type": "number" },
        "deliveryExpressBdt": { "type": "number" },
        "freeDeliveryThresholdBdt": { "type": "number" },
        "heavenPayEnabled": { "type": "boolean" },
        "manualPayEnabled": { "type": "boolean" },
        "autoPayEnabled": { "type": "boolean" },
        "autoPayProvider": { "type": "string", "maxLength": 60 },
        "autoPaySandbox": { "type": "boolean" },
        "walletEnabled": { "type": "boolean" },
        "bkashEnabled": { "type": "boolean" },
        "bkashNumber": { "type": "string", "maxLength": 30 },
        "nagadEnabled": { "type": "boolean" },
        "nagadNumber": { "type": "string", "maxLength": 30 },
        "rocketEnabled": { "type": "boolean" },
        "rocketNumber": { "type": "string", "maxLength": 30 },
        "upayEnabled": { "type": "boolean" },
        "upayNumber": { "type": "string", "maxLength": 30 },
        "cardGatewayEnabled": { "type": "boolean" },
        "gatewayFeePercent": { "type": "number" },
        "gatewayInstructions": { "type": "string", "maxLength": 400 },
