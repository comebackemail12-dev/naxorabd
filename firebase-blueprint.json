    "CodeOverrides": {
      "title": "CodeOverrides",
      "description": "Live custom CSS, theme tokens, and behavior flags pushed by Main Admin to User App and Normal Admin App.",
      "type": "object",
      "properties": {
        "userCustomCss": { "type": "string", "maxLength": 20000 },
        "userCustomJs": { "type": "string", "maxLength": 20000 },
        "adminCustomCss": { "type": "string", "maxLength": 20000 },
