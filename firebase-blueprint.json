      "required": [
        "brandName",
        "brandLogoUrl",
        "currencySymbol",
        "defaultLang",
        "gridColsDesktop",
        "cardCompactMode",
        "userAppEnabled",
        "adminAppEnabled",
        "codEnabled",
        "heavenPayEnabled",
        "manualPayEnabled",
        "autoPayEnabled",
        "walletEnabled",
        "deliveryInsideDhakaBdt",
        "deliveryOutsideDhakaBdt",
        "updatedAt"
      ]
