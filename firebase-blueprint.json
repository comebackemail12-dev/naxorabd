        "giftCardsEnabled": { "type": "boolean" },
        "tournamentsEnabled": { "type": "boolean" },
        "resellerDefaultDiscountPct": { "type": "number" },
        "lowStockThreshold": { "type": "integer", "minimum": 1, "maximum": 100 },
