rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Primitive Helpers ---
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isValidEmailId(id) {
      return id is string && id.size() >= 3 && id.size() <= 160 && id.matches('^[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}$');
    }
    function incoming() {
      return request.resource.data;
    }
    function existing() {
      return resource.data;
    }
    function isChanged(data, prev, field) {
      return data.diff(prev).affectedKeys().hasAny([field]);
    }
    function isSignedIn() {
      return request.auth != null;
    }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function hasVerifiedEmail() {
      return isVerifiedUser() &&
        ('email' in request.auth.token) &&
        request.auth.token.email is string;
    }
    function isMainAdmin() {
      return hasVerifiedEmail() && request.auth.token.email.lower() == 'comebackemail12@gmail.com';
    }
    function isApprovedAdmin() {
      return isVerifiedUser() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        ('status' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.status == 'approved';
    }
    function hasAdminPerm(perm) {
      return isMainAdmin() || (
        isApprovedAdmin() &&
        ('permissions' in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions is map &&
        perm in get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.permissions[perm] == true
      );
    }
    function isUserBanned() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        ('isBanned' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isBanned == true;
    }
    function canManageUsers() {
      return isMainAdmin() || hasAdminPerm('canManageUsers') || hasAdminPerm('canManageOrders');
    }

    // --- Validation Blueprints (Create + Partial-Safe Update) ---

    function isValidStoreBranding(data) {
      return data.brandName is string && data.brandName.size() >= 1 && data.brandName.size() <= 60 &&
        data.brandLogoUrl is string && data.brandLogoUrl.size() <= 500 &&
        data.currencySymbol is string && data.currencySymbol.size() >= 1 && data.currencySymbol.size() <= 8 &&
        data.defaultLang in ['bn', 'en'] &&
        (!('metaTitle' in data) || (data.metaTitle is string && data.metaTitle.size() <= 120)) &&
        (!('heroTitle' in data) || (data.heroTitle is string && data.heroTitle.size() >= 1 && data.heroTitle.size() <= 140)) &&
        (!('accentColor' in data) || (data.accentColor is string && data.accentColor.size() == 7 && data.accentColor.matches('^#[0-9a-fA-F]{6}$'))) &&
        (!('secondaryColor' in data) || (data.secondaryColor is string && data.secondaryColor.size() == 7 && data.secondaryColor.matches('^#[0-9a-fA-F]{6}$')));
    }

    function isValidStoreLayoutAndFlags(data) {
      return data.gridColsDesktop is int && data.gridColsDesktop >= 3 && data.gridColsDesktop <= 6 &&
        data.cardCompactMode is bool &&
        (!('sliderAutoPlayMs' in data) || (data.sliderAutoPlayMs is int && data.sliderAutoPlayMs >= 2000 && data.sliderAutoPlayMs <= 20000)) &&
        data.userAppEnabled is bool &&
        data.adminAppEnabled is bool &&
        (!('maintenanceMessage' in data) || (data.maintenanceMessage is string && data.maintenanceMessage.size() <= 300));
    }

    function isValidStoreGateway(data) {
      return data.codEnabled is bool &&
        data.deliveryInsideDhakaBdt is number && data.deliveryInsideDhakaBdt >= 0 &&
        data.deliveryOutsideDhakaBdt is number && data.deliveryOutsideDhakaBdt >= 0 &&
        (!('deliveryExpressBdt' in data) || (data.deliveryExpressBdt is number && data.deliveryExpressBdt >= 0)) &&
        data.heavenPayEnabled is bool &&
        data.manualPayEnabled is bool &&
        data.autoPayEnabled is bool &&
        data.walletEnabled is bool &&
        (!('gatewayFeePercent' in data) || (data.gatewayFeePercent is number && data.gatewayFeePercent >= 0 && data.gatewayFeePercent <= 25)) &&
        (!('comboMinQty' in data) || (data.comboMinQty is int && data.comboMinQty >= 2 && data.comboMinQty <= 20)) &&
        (!('lowStockThreshold' in data) || (data.lowStockThreshold is int && data.lowStockThreshold >= 1 && data.lowStockThreshold <= 100)) &&
        data.updatedAt is timestamp;
    }

    function isValidStoreConfig(data) {
      return data.keys().hasAll([
          'brandName', 'brandLogoUrl', 'currencySymbol', 'defaultLang',
          'gridColsDesktop', 'cardCompactMode', 'userAppEnabled', 'adminAppEnabled',
          'codEnabled', 'heavenPayEnabled', 'manualPayEnabled', 'autoPayEnabled',
          'walletEnabled', 'deliveryInsideDhakaBdt', 'deliveryOutsideDhakaBdt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'brandName', 'brandLogoUrl', 'brandTaglineBn', 'brandTaglineEn', 'footerTagBn', 'footerTagEn',
          'metaTitle', 'metaDescription', 'currencySymbol', 'defaultLang',
          'supportPhone', 'supportWhatsapp', 'supportEmail',
          'announcementBn', 'announcementEn', 'heroTitle', 'heroSubtitle',
          'accentColor', 'secondaryColor', 'gridColsDesktop', 'cardCompactMode', 'sliderAutoPlayMs',
          'showAnnouncementBar', 'showHeaderSearch', 'showHeaderNotices', 'showHeaderNotifs',
          'showLangToggle', 'showBottomNav', 'showHomeCategories', 'showRecentlyViewed',
          'showFooter', 'allowOrderCancel',
          'userAppEnabled', 'adminAppEnabled', 'maintenanceMessage',
          'flashDropEnabled', 'flashDropEndIso',
          'reviewsEnabled', 'couponsEnabled', 'wishlistEnabled', 'ticketsEnabled',
          'slidersEnabled', 'noticesEnabled', 'eMarketEnabled',
          'codEnabled', 'codMinOrderBdt', 'codMaxOrderBdt', 'codAdvanceDeliveryOutsideDhaka',
          'deliveryInsideDhakaBdt', 'deliveryOutsideDhakaBdt', 'deliveryExpressBdt',
          'freeDeliveryThresholdBdt', 'heavenPayEnabled',
          'manualPayEnabled', 'autoPayEnabled', 'autoPayProvider', 'autoPaySandbox', 'walletEnabled',
          'bkashEnabled', 'bkashNumber',
          'nagadEnabled', 'nagadNumber', 'rocketEnabled', 'rocketNumber',
          'upayEnabled', 'upayNumber', 'cardGatewayEnabled', 'gatewayFeePercent',
          'gatewayInstructions',
          'cashbackPercent', 'referralBonusBdt', 'comboMinQty', 'comboDiscountPercent', 'ffLookupEnabled',
          'reelsEnabled', 'spinWheelEnabled', 'dailyCheckInBdt', 'preOrderEnabled',
          'groupBuyEnabled', 'giftCardsEnabled', 'tournamentsEnabled', 'resellerDefaultDiscountPct',
          'lowStockThreshold', 'vipEnabled', 'emiEnabled', 'reviewBonusBdt', 'otpRequiredForOrder',
          'resellerCommissionPct', 'updatedAt'
        ]) &&
        isValidStoreBranding(data) &&
        isValidStoreLayoutAndFlags(data) &&
        isValidStoreGateway(data);
    }

    function isValidStoreConfigUpdate(data, prev) {
      return data.diff(prev).addedKeys().hasOnly([
          'brandName', 'brandLogoUrl', 'brandTaglineBn', 'brandTaglineEn', 'footerTagBn', 'footerTagEn',
          'metaTitle', 'metaDescription', 'currencySymbol', 'defaultLang',
          'supportPhone', 'supportWhatsapp', 'supportEmail',
          'announcementBn', 'announcementEn', 'heroTitle', 'heroSubtitle',
          'accentColor', 'secondaryColor', 'gridColsDesktop', 'cardCompactMode', 'sliderAutoPlayMs',
          'showAnnouncementBar', 'showHeaderSearch', 'showHeaderNotices', 'showHeaderNotifs',
          'showLangToggle', 'showBottomNav', 'showHomeCategories', 'showRecentlyViewed',
          'showFooter', 'allowOrderCancel',
          'userAppEnabled', 'adminAppEnabled', 'maintenanceMessage',
          'flashDropEnabled', 'flashDropEndIso',
          'reviewsEnabled', 'couponsEnabled', 'wishlistEnabled', 'ticketsEnabled',
          'slidersEnabled', 'noticesEnabled', 'eMarketEnabled',
          'codEnabled', 'codMinOrderBdt', 'codMaxOrderBdt', 'codAdvanceDeliveryOutsideDhaka',
          'deliveryInsideDhakaBdt', 'deliveryOutsideDhakaBdt', 'deliveryExpressBdt',
          'freeDeliveryThresholdBdt', 'heavenPayEnabled',
          'manualPayEnabled', 'autoPayEnabled', 'autoPayProvider', 'autoPaySandbox', 'walletEnabled',
          'bkashEnabled', 'bkashNumber',
          'nagadEnabled', 'nagadNumber', 'rocketEnabled', 'rocketNumber',
          'upayEnabled', 'upayNumber', 'cardGatewayEnabled', 'gatewayFeePercent',
          'gatewayInstructions',
          'cashbackPercent', 'referralBonusBdt', 'comboMinQty', 'comboDiscountPercent', 'ffLookupEnabled',
          'reelsEnabled', 'spinWheelEnabled', 'dailyCheckInBdt', 'preOrderEnabled',
          'groupBuyEnabled', 'giftCardsEnabled', 'tournamentsEnabled', 'resellerDefaultDiscountPct',
          'lowStockThreshold', 'vipEnabled', 'emiEnabled', 'reviewBonusBdt', 'otpRequiredForOrder',
          'resellerCommissionPct', 'updatedAt'
        ]) &&
        data.diff(prev).changedKeys().hasOnly([
          'brandName', 'brandLogoUrl', 'brandTaglineBn', 'brandTaglineEn', 'footerTagBn', 'footerTagEn',
          'metaTitle', 'metaDescription', 'currencySymbol', 'defaultLang',
          'supportPhone', 'supportWhatsapp', 'supportEmail',
          'announcementBn', 'announcementEn', 'heroTitle', 'heroSubtitle',
          'accentColor', 'secondaryColor', 'gridColsDesktop', 'cardCompactMode', 'sliderAutoPlayMs',
          'showAnnouncementBar', 'showHeaderSearch', 'showHeaderNotices', 'showHeaderNotifs',
          'showLangToggle', 'showBottomNav', 'showHomeCategories', 'showRecentlyViewed',
          'showFooter', 'allowOrderCancel',
          'userAppEnabled', 'adminAppEnabled', 'maintenanceMessage',
          'flashDropEnabled', 'flashDropEndIso',
          'reviewsEnabled', 'couponsEnabled', 'wishlistEnabled', 'ticketsEnabled',
          'slidersEnabled', 'noticesEnabled', 'eMarketEnabled',
          'codEnabled', 'codMinOrderBdt', 'codMaxOrderBdt', 'codAdvanceDeliveryOutsideDhaka',
          'deliveryInsideDhakaBdt', 'deliveryOutsideDhakaBdt', 'deliveryExpressBdt',
          'freeDeliveryThresholdBdt', 'heavenPayEnabled',
          'manualPayEnabled', 'autoPayEnabled', 'autoPayProvider', 'autoPaySandbox', 'walletEnabled',
          'bkashEnabled', 'bkashNumber',
          'nagadEnabled', 'nagadNumber', 'rocketEnabled', 'rocketNumber',
          'upayEnabled', 'upayNumber', 'cardGatewayEnabled', 'gatewayFeePercent',
          'gatewayInstructions',
          'cashbackPercent', 'referralBonusBdt', 'comboMinQty', 'comboDiscountPercent', 'ffLookupEnabled',
          'reelsEnabled', 'spinWheelEnabled', 'dailyCheckInBdt', 'preOrderEnabled',
          'groupBuyEnabled', 'giftCardsEnabled', 'tournamentsEnabled', 'resellerDefaultDiscountPct',
          'lowStockThreshold', 'vipEnabled', 'emiEnabled', 'reviewBonusBdt', 'otpRequiredForOrder',
          'resellerCommissionPct', 'updatedAt'
        ]) &&
        isValidStoreBranding(data) &&
        isValidStoreLayoutAndFlags(data) &&
        isValidStoreGateway(data);
    }

    function isValidCodeOverrides(data) {
      return data.keys().hasAll(['userCustomCss', 'userCustomJs', 'adminCustomCss', 'adminCustomJs', 'updatedAt', 'updatedBy']) &&
        data.keys().hasOnly(['userCustomCss', 'userCustomJs', 'adminCustomCss', 'adminCustomJs', 'updatedAt', 'updatedBy']) &&
        data.userCustomCss is string && data.userCustomCss.size() <= 20000 &&
        data.userCustomJs is string && data.userCustomJs.size() <= 20000 &&
        data.adminCustomCss is string && data.adminCustomCss.size() <= 20000 &&
        data.adminCustomJs is string && data.adminCustomJs.size() <= 20000 &&
        data.updatedBy is string && data.updatedBy.size() <= 128 &&
        data.updatedAt is timestamp;
    }

    function isValidCodeOverridesUpdate(data, prev) {
      return data.diff(prev).addedKeys().hasOnly(['userCustomCss', 'userCustomJs', 'adminCustomCss', 'adminCustomJs', 'updatedAt', 'updatedBy']) &&
        data.diff(prev).changedKeys().hasOnly(['userCustomCss', 'userCustomJs', 'adminCustomCss', 'adminCustomJs', 'updatedAt', 'updatedBy']) &&
        (!isChanged(data, prev, 'userCustomCss') || (data.userCustomCss is string && data.userCustomCss.size() <= 20000)) &&
        (!isChanged(data, prev, 'userCustomJs') || (data.userCustomJs is string && data.userCustomJs.size() <= 20000)) &&
        (!isChanged(data, prev, 'adminCustomCss') || (data.adminCustomCss is string && data.adminCustomCss.size() <= 20000)) &&
        (!isChanged(data, prev, 'adminCustomJs') || (data.adminCustomJs is string && data.adminCustomJs.size() <= 20000)) &&
        (!isChanged(data, prev, 'updatedBy') || (data.updatedBy is string && data.updatedBy.size() <= 128)) &&
        data.updatedAt is timestamp;
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['nameEn', 'nameBn', 'slug', 'sortOrder', 'isActive', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['nameEn', 'nameBn', 'slug', 'sortOrder', 'isActive', 'createdAt', 'updatedAt']) &&
        data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 60 &&
        data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 80 &&
        data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 60 && data.slug.matches('^[a-z0-9\\-]+$') &&
        data.sortOrder is int &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategoryUpdate(data, prev) {
      return data.diff(prev).affectedKeys().hasOnly(['nameEn', 'nameBn', 'slug', 'sortOrder', 'isActive', 'updatedAt']) &&
        (!('createdAt' in prev) || data.createdAt == prev.createdAt) &&
        (!isChanged(data, prev, 'nameEn') || (data.nameEn is string && data.nameEn.size() >= 1 && data.nameEn.size() <= 60)) &&
        (!isChanged(data, prev, 'nameBn') || (data.nameBn is string && data.nameBn.size() >= 1 && data.nameBn.size() <= 80)) &&
        (!isChanged(data, prev, 'slug') || (data.slug is string && data.slug.size() >= 1 && data.slug.size() <= 60 && data.slug.matches('^[a-z0-9\\-]+$'))) &&
        (!isChanged(data, prev, 'sortOrder') || data.sortOrder is int) &&
        (!isChanged(data, prev, 'isActive') || data.isActive is bool) &&
        data.updatedAt is timestamp;
    }

    function isValidProduct(data) {
      return data.keys().hasAll([
          'title', 'subtitleBn', 'categoryId', 'priceBdt', 'compareAtBdt', 'stock',
          'viralSource', 'imageUrl', 'variants', 'isFeatured',
          'isFlashDrop', 'isActive', 'salesCount', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'title', 'subtitleBn', 'categoryId', 'priceBdt', 'compareAtBdt', 'costPriceBdt', 'stock',
          'viralSource', 'imageUrl', 'galleryUrls', 'videoUrl', 'description', 'variants', 'variantDetails',
          'isFeatured', 'isFlashDrop', 'isActive', 'salesCount',
          'isPreOrder', 'preOrderDepositPct', 'preOrderEta',
          'groupBuyEnabled', 'groupBuyPriceBdt', 'groupBuySize',
          'resellerPriceBdt', 'emiEligible', 'fbtProductIds', 'createdBy', 'createdAt', 'updatedAt'
        ]) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 120 &&
        data.subtitleBn is string && data.subtitleBn.size() <= 160 &&
        data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 60 && data.categoryId.matches('^[a-zA-Z0-9_\\-]+$') &&
        data.priceBdt is number && data.priceBdt > 0 &&
        data.compareAtBdt is number && data.compareAtBdt >= 0 &&
        (!('costPriceBdt' in data) || (data.costPriceBdt is number && data.costPriceBdt >= 0)) &&
        data.stock is int && data.stock >= 0 &&
        data.viralSource is string && data.viralSource.size() <= 60 &&
        data.imageUrl is string && data.imageUrl.size() <= 500 &&
        (!('galleryUrls' in data) || (data.galleryUrls is list && data.galleryUrls.size() <= 6 && (data.galleryUrls.size() == 0 || data.galleryUrls[0] is string))) &&
        (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 500)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1500)) &&
        data.variants is list && data.variants.size() <= 12 &&
        (data.variants.size() == 0 || data.variants[0] is string) &&
        (!('variantDetails' in data) || (data.variantDetails is list && data.variantDetails.size() <= 12)) &&
        (!('isPreOrder' in data) || data.isPreOrder is bool) &&
        (!('preOrderDepositPct' in data) || (data.preOrderDepositPct is number && data.preOrderDepositPct >= 5 && data.preOrderDepositPct <= 100)) &&
        (!('preOrderEta' in data) || (data.preOrderEta is string && data.preOrderEta.size() <= 60)) &&
        (!('groupBuyEnabled' in data) || data.groupBuyEnabled is bool) &&
        (!('groupBuyPriceBdt' in data) || (data.groupBuyPriceBdt is number && data.groupBuyPriceBdt >= 0)) &&
        (!('groupBuySize' in data) || (data.groupBuySize is int && data.groupBuySize >= 2 && data.groupBuySize <= 10)) &&
        (!('resellerPriceBdt' in data) || (data.resellerPriceBdt is number && data.resellerPriceBdt >= 0)) &&
        (!('emiEligible' in data) || data.emiEligible is bool) &&
        (!('fbtProductIds' in data) || (data.fbtProductIds is list && data.fbtProductIds.size() <= 8)) &&
        data.isFeatured is bool &&
        data.isFlashDrop is bool &&
        data.isActive is bool &&
        data.salesCount is int && data.salesCount >= 0 &&
        data.createdBy is string && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProductUpdate(data, prev) {
      return data.diff(prev).affectedKeys().hasOnly([
          'title', 'subtitleBn', 'categoryId', 'priceBdt', 'compareAtBdt', 'costPriceBdt', 'stock',
          'viralSource', 'imageUrl', 'galleryUrls', 'videoUrl', 'description', 'variants', 'variantDetails',
          'isFeatured', 'isFlashDrop', 'isActive', 'salesCount',
          'isPreOrder', 'preOrderDepositPct', 'preOrderEta',
          'groupBuyEnabled', 'groupBuyPriceBdt', 'groupBuySize',
          'resellerPriceBdt', 'emiEligible', 'fbtProductIds', 'updatedAt'
        ]) &&
        (!('createdBy' in prev) || data.createdBy == prev.createdBy) &&
        (!('createdAt' in prev) || data.createdAt == prev.createdAt) &&
        (!isChanged(data, prev, 'title') || (data.title is string && data.title.size() >= 2 && data.title.size() <= 120)) &&
        (!isChanged(data, prev, 'subtitleBn') || (data.subtitleBn is string && data.subtitleBn.size() <= 160)) &&
        (!isChanged(data, prev, 'categoryId') || (data.categoryId is string && data.categoryId.size() >= 1 && data.categoryId.size() <= 60 && data.categoryId.matches('^[a-zA-Z0-9_\\-]+$'))) &&
        (!isChanged(data, prev, 'priceBdt') || (data.priceBdt is number && data.priceBdt > 0)) &&
        (!isChanged(data, prev, 'compareAtBdt') || (data.compareAtBdt is number && data.compareAtBdt >= 0)) &&
        (!isChanged(data, prev, 'costPriceBdt') || (data.costPriceBdt is number && data.costPriceBdt >= 0)) &&
        (!isChanged(data, prev, 'stock') || (data.stock is int && data.stock >= 0)) &&
        (!isChanged(data, prev, 'viralSource') || (data.viralSource is string && data.viralSource.size() <= 60)) &&
        (!isChanged(data, prev, 'imageUrl') || (data.imageUrl is string && data.imageUrl.size() <= 500)) &&
        (!isChanged(data, prev, 'galleryUrls') || (data.galleryUrls is list && data.galleryUrls.size() <= 6 && (data.galleryUrls.size() == 0 || data.galleryUrls[0] is string))) &&
        (!isChanged(data, prev, 'videoUrl') || (data.videoUrl is string && data.videoUrl.size() <= 500)) &&
        (!isChanged(data, prev, 'description') || (data.description is string && data.description.size() <= 1500)) &&
        (!isChanged(data, prev, 'variants') || (data.variants is list && data.variants.size() <= 12 && (data.variants.size() == 0 || data.variants[0] is string))) &&
        (!isChanged(data, prev, 'variantDetails') || (data.variantDetails is list && data.variantDetails.size() <= 12)) &&
        (!isChanged(data, prev, 'isFeatured') || data.isFeatured is bool) &&
        (!isChanged(data, prev, 'isFlashDrop') || data.isFlashDrop is bool) &&
        (!isChanged(data, prev, 'isActive') || data.isActive is bool) &&
        (!isChanged(data, prev, 'salesCount') || (data.salesCount is int && data.salesCount >= 0)) &&
        (!isChanged(data, prev, 'isPreOrder') || data.isPreOrder is bool) &&
        (!isChanged(data, prev, 'preOrderDepositPct') || (data.preOrderDepositPct is number && data.preOrderDepositPct >= 5 && data.preOrderDepositPct <= 100)) &&
        (!isChanged(data, prev, 'preOrderEta') || (data.preOrderEta is string && data.preOrderEta.size() <= 60)) &&
        (!isChanged(data, prev, 'groupBuyEnabled') || data.groupBuyEnabled is bool) &&
        (!isChanged(data, prev, 'groupBuyPriceBdt') || (data.groupBuyPriceBdt is number && data.groupBuyPriceBdt >= 0)) &&
        (!isChanged(data, prev, 'groupBuySize') || (data.groupBuySize is int && data.groupBuySize >= 2 && data.groupBuySize <= 10)) &&
        (!isChanged(data, prev, 'resellerPriceBdt') || (data.resellerPriceBdt is number && data.resellerPriceBdt >= 0)) &&
        (!isChanged(data, prev, 'emiEligible') || data.emiEligible is bool) &&
        (!isChanged(data, prev, 'fbtProductIds') || (data.fbtProductIds is list && data.fbtProductIds.size() <= 8)) &&
        data.updatedAt is timestamp;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['userId', 'userName', 'rating', 'comment', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'userName', 'rating', 'comment', 'photoUrl', 'isVerifiedBuyer', 'createdAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.rating is int && data.rating >= 1 && data.rating <= 5 &&
        data.comment is string && data.comment.size() >= 2 && data.comment.size() <= 600 &&
        (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
        (!('isVerifiedBuyer' in data) || data.isVerifiedBuyer is bool) &&
        data.createdAt is timestamp;
    }

    function isValidProductQuestion(data) {
      return data.keys().hasAll(['userId', 'userName', 'question', 'answer', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['userId', 'userName', 'question', 'answer', 'answeredBy', 'answeredAt', 'createdAt', 'updatedAt']) &&
        data.userId is string && data.userId.size() <= 128 &&
        data.userName is string && data.userName.size() >= 1 && data.userName.size() <= 80 &&
        data.question is string && data.question.size() >= 3 && data.question.size() <= 500 &&
        data.answer is string && data.answer.size() <= 800 &&
        (!('answeredBy' in data) || (data.answeredBy is string && data.answeredBy.size() <= 128)) &&
        (!('answeredAt' in data) || data.answeredAt is timestamp) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidProductQuestionUpdate(data, prev) {
      return data.diff(prev).affectedKeys().hasOnly(['answer', 'answeredBy', 'answeredAt', 'updatedAt']) &&
        (!('userId' in prev) || data.userId == prev.userId) &&
        (!('question' in prev) || data.question == prev.question) &&
        (!('createdAt' in prev) || data.createdAt == prev.createdAt) &&
        (!isChanged(data, prev, 'answer') || (data.answer is string && data.answer.size() <= 800)) &&
        (!isChanged(data, prev, 'answeredBy') || (data.answeredBy is string && data.answeredBy.size() <= 128)) &&
        (!isChanged(data, prev, 'answeredAt') || data.answeredAt is timestamp) &&
        data.updatedAt is timestamp;
    }

    function isValidCoupon(data) {
      return data.keys().hasAll(['code', 'discountType', 'discountValue', 'minOrderBdt', 'isActive', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['code', 'discountType', 'discountValue', 'minOrderBdt', 'isActive', 'createdBy', 'createdAt', 'updatedAt']) &&
        data.code is string && data.code.size() >= 2 && data.code.size() <= 30 && data.code.matches('^[A-Z0-9_\\-]+$') &&
        data.discountType in ['percent', 'fixed'] &&
        data.discountValue is number && data.discountValue > 0 &&
        data.minOrderBdt is number && data.minOrderBdt >= 0 &&
        data.isActive is bool &&
        data.createdBy is string && data.createdBy.size() <= 128 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCouponUpdate(data, prev) {
